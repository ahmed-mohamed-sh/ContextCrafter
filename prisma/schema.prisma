generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String?       @unique
  emailVerified  DateTime?
  image          String?
  githubUsername String?
  githubToken    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  chatSessions   ChatSession[]
  repositories   Repository[]
  sessions       Session[]
  settings      UserSettings?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Repository {
  id              String        @id @default(cuid())
  userId          String
  githubId        Int           @unique
  name            String
  fullName        String
  description     String?
  url             String
  private         Boolean       @default(false)
  language        String?
  stars           Int           @default(0)
  status          RepoStatus    @default(PENDING)
  analyzedAt      DateTime?
  totalFiles      Int           @default(0)
  totalComponents Int           @default(0)
  totalAPIs       Int           @default(0)
  totalModels     Int           @default(0)
  healthScore     Int           @default(0)
  aiScore         Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  aiReview        Json?
  reviewedAt      DateTime?
  chatSessions    ChatSession[]
  decisions       Decision[]
  embeddings      Embedding[]
  files           RepoFile[]
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RepoFile {
  id           String      @id @default(cuid())
  repositoryId String
  path         String
  name         String
  extension    String?
  size         Int?
  content      String?
  language     String?
  complexity   Int?
  linesOfCode  Int?
  isDeadCode   Boolean     @default(false)
  fromConnections FileConnection[] @relation("FromConnections")
  toConnections   FileConnection[] @relation("ToConnections")
  embeddings   Embedding[]
  repository   Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, path])
}

model Embedding {
  id           String   @id @default(cuid())
  repositoryId String
  fileId       String?
  content      String
  vector       Unsupported("vector(384)")?
  metadata     Json?

  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  file       RepoFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
}

model FileConnection {
  id         String @id @default(cuid())
  fromFileId String
  toFileId   String
  type       String @default("import")

  fromFile RepoFile @relation("FromConnections", fields: [fromFileId], references: [id], onDelete: Cascade)
  toFile   RepoFile @relation("ToConnections", fields: [toFileId], references: [id], onDelete: Cascade)

  @@unique([fromFileId, toFileId])
}

model ChatSession {
  id           String     @id @default(cuid())
  userId       String
  repositoryId String
  title        String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages     Message[]
}

model Message {
  id            String      @id @default(cuid())
  chatSessionId String
  role          MessageRole
  content       String
  sources       Json?
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
}

model UserSettings {
  id           String  @id @default(cuid())
  userId       String  @unique
  llmProvider  String  @default("groq")
  llmApiKey    String?
  embedModel   String  @default("nomic")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Decision {
  id           String     @id @default(cuid())
  repositoryId String
  title        String
  context      String
  tags         String[]
  source       String?
  createdAt    DateTime   @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
}

enum RepoStatus {
  PENDING
  ANALYZING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}
